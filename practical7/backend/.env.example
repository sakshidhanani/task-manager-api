# Copy this file to .env and fill in your own values.
# Local MongoDB:
MONGO_URI=mongodb://127.0.0.1:27017/taskmanager

# OR MongoDB Atlas (example):
# MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/taskmanager

PORT=5000

# Secret used to sign/verify JWTs. Use a long, random string in real projects.
# NEVER commit the real value - this file is only an example/template.
JWT_SECRET=change_this_to_a_long_random_string_before_running
